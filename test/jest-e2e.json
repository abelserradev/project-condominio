{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/bullmq$": "<rootDir>/__mocks__/nestjs-bullmq.ts",
    "^bullmq$": "<rootDir>/__mocks__/bullmq.ts"
  }
}
